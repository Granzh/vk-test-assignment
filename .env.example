BOT_TOKEN=
DATABASE_URL=postgres://bot:bot@localhost:5432/bot?sslmode=disable
ADMIN_IDS=
TIMEZONE=Europe/Moscow
# First and last campaign day, YYYY-MM-DD
CAMPAIGN_START=2026-09-01
CAMPAIGN_END=2026-09-30
MAX_CHANCES=10
# Start of the campaign day, HH:MM in TIMEZONE
DAY_BOUNDARY=00:00
# How long a final winner has to give the contact data before the prize goes to the next reserve
WINNER_RESPONSE_TIMEOUT=48h
# true: the bot holds each finished day's draw itself and sends admins the preview;
# winners are notified only after /draw_confirm
AUTO_DRAW=false
# Final draw: winners (each wins once), reserve queue, prize tickets per winner, prize name
FINAL_WINNERS=5
FINAL_RESERVES=5
FINAL_PRIZE_TICKETS=2
FINAL_PRIZE=главный приз акции
# Broadcast speed, messages per second (Telegram allows about 30)
BROADCAST_RATE=25

# Capacity (docs/load-test.md)
# Database pool size; keep the sum over all instances below Postgres max_connections (100)
DB_MAX_CONNS=20
# Updates handled at once; the rest wait up to 15 s. Keep MAX_CONCURRENT_UPDATES / TELEGRAM_CHECKS_PER_SECOND below ~12
MAX_CONCURRENT_UPDATES=200
# getChatMember calls per second for all users together (Telegram allows about 30 requests/s per bot)
TELEGRAM_CHECKS_PER_SECOND=25
# How long a positive subscription check is reused; 0 turns the cache off
SUBSCRIPTION_CACHE_TTL=30s
# /metrics, /healthz, /readyz; "off" disables. Do not publish this port to the internet
METRICS_LISTEN=:9090
# polling (default) or webhook
UPDATES_MODE=polling
# webhook mode only (WEBHOOK_SECRET is required: Telegram sends it with every update)
WEBHOOK_URL=
WEBHOOK_LISTEN=:8080
WEBHOOK_SECRET=
# webhook profile: public domain served by Caddy; WEBHOOK_URL=https://<domain>/
WEBHOOK_DOMAIN=

# Host port of the compose Postgres (change if 5432 is taken)
POSTGRES_PORT=5432

# docker-compose.prod.yml only: password of the database (openssl rand -hex 24) and backup settings
POSTGRES_PASSWORD=
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
